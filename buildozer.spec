[app]

title = Flip Fly
package.name = flipfly
package.domain = org.flipfly

source.dir = .
source.include_exts = py

version = 1.0

requirements = python3,pygame

orientation = portrait
fullscreen = 1

android.archs = arm64-v8a

android.accept_sdk_license = True

[buildozer]

log_level = 2
warn_on_root = 1
